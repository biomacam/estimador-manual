# LLM Provider configuration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
# LLM_MODEL is optional: if unset, it's derived from LLM_PROVIDER
# (gpt-4o-mini for openai, claude-haiku-4-5 for anthropic)
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2

# Application
APP_ENV=development
LOG_LEVEL=DEBUG
